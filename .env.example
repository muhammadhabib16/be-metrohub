NODE_ENV=development
PORT=3000

# Sesuai docker-compose.yml untuk development lokal
DATABASE_URL="mysql://root:root@localhost:3306/metrohub"

# Wajib minimal 32 karakter. Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
JWT_EXPIRES_IN=1d

# Folder penyimpanan foto absensi (di Railway: path mount Volume, misalnya /data/uploads)
UPLOAD_DIR=./uploads

APP_URL=http://localhost:3000

# Dipakai prisma/seed.js
SEED_ADMIN_EMAIL=admin@metrohub.local
SEED_ADMIN_PASSWORD=admin12345
