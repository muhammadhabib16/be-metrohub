# Salin menjadi .env.production di homeserver, lalu ganti semua nilai "GANTI_...".
# File .env.production sudah di-ignore git. Jangan di-commit.

# ===== MySQL (dibaca container mysql saat volume database pertama kali dibuat) =====
MYSQL_ROOT_PASSWORD=GANTI_password_root_acak
MYSQL_DATABASE=metrohub
MYSQL_USER=metrohub
MYSQL_PASSWORD=GANTI_password_app_acak

# ===== Aplikasi =====
# Host "mysql" = nama service di docker-compose.prod.yml. User/password harus sama dengan di atas.
# Jika password berisi karakter khusus (@ : / ? # %), encode dulu, misalnya @ menjadi %40.
DATABASE_URL="mysql://metrohub:GANTI_password_app_acak@mysql:3306/metrohub"

# Minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GANTI_string_acak_minimal_32_karakter
JWT_EXPIRES_IN=1d

# Domain HTTPS publik yang dipakai pengguna
APP_URL=https://metrohub.contoh-domain.com

# ===== Seed admin pertama (dipakai sekali oleh: npm run db:seed) =====
# Wajib diisi; kalau kosong seed memakai default admin12345 yang tidak aman.
SEED_ADMIN_EMAIL=admin@contoh-domain.com
SEED_ADMIN_PASSWORD=GANTI_password_admin_kuat

# ===== Backup harian (NF-10) =====
BACKUP_RETENTION_DAYS=14
